# 复制成 .env 后按需修改；compose.yaml 会读它。
# .env 已经在 .gitignore 里，不会被提交。

# 站点对外端口
HTTP_PORT=8080

# 站点时区，「今天」和「相恋第 N 天」都按它算
SITE_TIMEZONE=Asia/Shanghai

# 首次启动时创建的两个账号。
# 口令留空会随机生成一串，用 docker compose logs web 查看
BOY_USERNAME=boy
BOY_PASSWORD=
GIRL_USERNAME=girl
GIRL_PASSWORD=

# 附件默认存在容器的 /data/uploads 里。
# 下面五项全部填好才会切到阿里云 OSS，缺一项就继续用本地目录。
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
# 用了自定义 API 端点再填，留空按 Region 拼 https://oss-<region>.aliyuncs.com
OSS_API_ENDPOINT=
OSS_PREFIX=ourstory/public
