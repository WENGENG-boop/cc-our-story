<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <Product>CC Our Story</Product>
    <Company>keeleycenc</Company>
    <Authors>keeleycenc</Authors>
    <Copyright>Copyright (c) keeleycenc</Copyright>
    <Version>1.0.0</Version>
    <RepositoryUrl>https://github.com/keeleycenc/CC.OurStory</RepositoryUrl>
  </PropertyGroup>

  <!-- 所有项目共用同一套包版本，升级时只改这里 -->
  <PropertyGroup>
    <MicrosoftExtensionsVersion>10.0.10</MicrosoftExtensionsVersion>
    <EntityFrameworkVersion>10.0.10</EntityFrameworkVersion>
    <SQLitePCLRawVersion>2.1.12</SQLitePCLRawVersion>
    <MarkdigVersion>1.3.2</MarkdigVersion>
    <XunitVersion>2.9.3</XunitVersion>
  </PropertyGroup>

</Project>
