@page "/login"
@model LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "登录";
}
<div class="auth-card">
    <span class="auth-mark">@Icon("heart")</span>
    <p class="auth-eyebrow">OUR STORY</p>
    <h1>@Model.SiteTitle</h1>
    <p class="auth-hint">一个只属于我们的角落，写下相伴的每一天</p>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="auth-error">@Icon("circle-alert")@Model.Error</p>
    }

    <form method="post">
        <label>
            <span>登录名</span>
            <input asp-for="UserName" autocomplete="username" maxlength="32" required autofocus>
        </label>
        <label>
            <span>口令</span>
            <input asp-for="Password" type="password" autocomplete="current-password" required>
        </label>
        <label class="auth-remember">
            <input asp-for="RememberMe" type="checkbox">
            <span>三十天内不用再登录</span>
        </label>
        <button type="submit">@Icon("arrow-right")进入后台</button>
    </form>

    <a class="auth-back" href="/">@Icon("arrow-left")回到首页</a>
</div>
