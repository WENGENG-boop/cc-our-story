@model PaginationModel
@*
    翻页条，结构和原主题一致：一个 ol，当前页那一项挂 .current。
    只有一页时整块不渲染。
*@
@if (Model.TotalPages > 1)
{
    <ol class="page-navigator">
        @if (Model.Page > 1)
        {
            <li><a href="@Model.UrlFor(Model.Page - 1)" aria-label="上一页">@Icon("chevron-left", null, "上一页")</a></li>
        }
        @foreach (var number in Model.VisiblePages())
        {
            if (number == Model.Page)
            {
                <li class="current"><span aria-current="page">@number</span></li>
            }
            else
            {
                <li><a href="@Model.UrlFor(number)">@number</a></li>
            }
        }
        @if (Model.Page < Model.TotalPages)
        {
            <li><a href="@Model.UrlFor(Model.Page + 1)" aria-label="下一页">@Icon("chevron-right", null, "下一页")</a></li>
        }
    </ol>
}
